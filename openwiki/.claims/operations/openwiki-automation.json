        }
      ]
    },
    {
      "id": "claim_375f37a8c2084a4eb321e024323dc242",
      "statement": "Der Checkout nutzt `fetch-depth: 0`, weil `openwiki code --update` HEAD gegen den zuletzt dokumentierten Commit diffen muss; ein flacher Clone würde diesen Commit verbergen und eine leere Änderungszusammenfassung verursachen.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L16-L22",
